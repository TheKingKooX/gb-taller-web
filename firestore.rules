rules_version = '2';

// ===============================================================
// Assumed Data Model — GB Taller y Repuestos (gb-taller-pe)
// ===============================================================
//
// Admin Identity:
//   - Single verified workshop owner:
//     request.auth != null &&
//     request.auth.token.email_verified == true &&
//     request.auth.token.email == 'thekingkoox@gmail.com'
//
// Collection: inventory
// Document ID: {productId} (e.g., 'disco', 'faja', 'item_173...')
// Access: Public read (catalog storefront, zero PII); Admin-only create/update/delete.
// Fields:
//   - id: string (required, immutable on update, 1..64 chars)
//   - sku: string (required, 1..40 chars)
//   - brand: string (required, 1..80 chars)
//   - name: string (required, 1..160 chars)
//   - cat: string (required, 1..40 chars)
//   - price: number (required, >= 0 && <= 100000)
//   - was: number | null (optional, if non-null >= 0 && <= 100000)
//   - stock: number (required, >= 0 && <= 100000)
//   - tag: string (optional, 0..40 chars)
//   - tagType: string (optional, 0..20 chars)
//   - excl: bool (optional)
//   - fits: list<string> (required, max 10 items)
//   - fitText: string (optional, 0..160 chars)
//   - img: string (required, 1..750000 chars; asset path, https URL, or data:image/ URL)
//   - spec: string (optional, 0..1000 chars)
//   - models: string (optional, 0..500 chars)
//   - updatedAt: number | timestamp (optional, non-negative number or timestamp)
//
// Collection: sales
// Document ID: {saleId}
// Access: Public/unauthenticated create (storefront checkout, strict schema,
//         status MUST be 'Pendiente' and stockDeducted MUST be false);
//         Admin-only read, update (status/stockDeducted/updatedAt only), and delete.
// Fields:
//   - id: string (required, immutable, 3..24 chars, e.g., '#GB-1043')
//   - date: string (required, immutable, 1..60 chars)
//   - createdAt: number | timestamp (required, immutable; recent on public create)
//   - client: string (required, immutable, 1..80 chars) [PII]
//   - phone: string (required, immutable, 6..15 chars, digits/+/-/spaces) [PII]
//   - moto: string (required, immutable, 1..100 chars) [PII]
//   - delivery: string (required, immutable, 1..140 chars) [PII]
//   - install: bool (required, immutable)
//   - payMethod: string (required, immutable, 1..80 chars)
//   - status: string (required, enum: 'Pendiente' | 'Pagado' | 'Entregado' | 'Cancelado';
//                     MUST be 'Pendiente' on non-admin create)
//   - stockDeducted: bool (required; MUST be false on non-admin create)
//   - total: number (required, immutable, > 0 && <= 50000)
//   - items: list<map> (required, immutable, 1..30 items; validated {id, sku, name, qty, price})
//   - updatedAt: number | timestamp (optional, Admin update only)
//
// Collection: order_status
// Document ID: {saleId} (matches /sales/{saleId}; unguessable random ID)
// Access: Public single-doc get (zero-PII live order tracking via onSnapshot);
//         NEVER public list (blocks collection enumeration);
//         Admin-only list, update, and delete;
//         Public create (status == 'Pendiente', verifiedAt == null, receiptCode == '')
//         or Admin create (supports merge-set on legacy sales without order_status doc).
// Fields:
//   - orderId: string (required, immutable, 3..24 chars, e.g., '#GB-1043')
//   - status: string (required, enum: 'Pendiente' | 'Pagado' | 'Entregado' | 'Cancelado';
//                     MUST be 'Pendiente' on non-admin create)
//   - total: number (required, immutable, > 0 && <= 50000)
//   - payMethod: string (required, immutable, 1..80 chars)
//   - verifiedAt: null | number | timestamp (required; MUST be null on non-admin create;
//                 if number, 0..9999999999999)
//   - receiptCode: string (required, 0..40 chars; MUST be '' on non-admin create)
//   - updatedAt: number | timestamp (optional, non-negative number or timestamp)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions (Lean AST — strictly well below 1000-expr limit)
    // ===============================================================

    // Check if the authenticated user is the verified workshop owner (Admin)
    function isAdmin() {
      return request.auth != null &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email == 'thekingkoox@gmail.com';
    }

    // Validate string length on a required field
    function validStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate optional string (if present, must be string within length)
    function optStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate optional timestamp or non-negative epoch number
    function optTimeOrNum(data, field) {
      return !(field in data) ||
             data[field] is timestamp ||
             (data[field] is number && data[field] >= 0 && data[field] <= 9999999999999);
    }

    // Validate createdAt on public checkout creation (prevents wild past/future spoofing)
    function isReasonableCreatedAt(val) {
      return (val is timestamp &&
              val > request.time - duration.value(5, 'm') &&
              val <= request.time) ||
             (val is number &&
              val >= request.time.toMillis() - 86400000 &&
              val <= request.time.toMillis() + 86400000);
    }

    // ===============================================================
    // Domain Validators — Inventory
    // ===============================================================

    // Validate product image: relative asset path, https URL, or base64 data:image/ URL (<= ~732KB)
    function isValidProductImg(img) {
      return img is string &&
             img.size() >= 1 &&
             img.size() <= 750000 &&
             (
               (img.size() <= 512 &&
                !img.matches('.*\\.\\..*') &&
                (img.matches('^assets/[a-zA-Z0-9._/-]+$') ||
                 img.matches('^https://.*'))) ||
               (img.size() > 22 && img[0:11] == 'data:image/')
             );
    }

    // Fast-path validator for Admin stock/price updates & writeBatch stock deductions
    function isValidInventoryQuickUpdate(prev, next) {
      return next.diff(prev).affectedKeys().hasOnly(['stock', 'price', 'updatedAt']) &&
             next.stock is number && next.stock >= 0 && next.stock <= 100000 &&
             next.price is number && next.price >= 0 && next.price <= 100000 &&
             optTimeOrNum(next, 'updatedAt');
    }

    // Full inventory document validator (Admin create & full edit modal updates)
    function isValidInventoryItem(data) {
      return data.keys().hasOnly([
               'id', 'sku', 'brand', 'name', 'cat', 'price', 'was',
               'stock', 'tag', 'tagType', 'excl', 'fits', 'fitText',
               'img', 'spec', 'models', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'id', 'sku', 'brand', 'name', 'cat', 'price', 'stock', 'fits', 'img'
             ]) &&
             validStr(data.id, 1, 64) &&
             validStr(data.sku, 1, 40) &&
             validStr(data.brand, 1, 80) &&
             validStr(data.name, 1, 160) &&
             validStr(data.cat, 1, 40) &&
             data.price is number && data.price >= 0 && data.price <= 100000 &&
             (!('was' in data) || data.was == null ||
              (data.was is number && data.was >= 0 && data.was <= 100000)) &&
             data.stock is number && data.stock >= 0 && data.stock <= 100000 &&
             optStr(data, 'tag', 40) &&
             optStr(data, 'tagType', 20) &&
             (!('excl' in data) || data.excl is bool) &&
             data.fits is list && data.fits.size() <= 10 &&
             (data.fits.size() == 0 || validStr(data.fits[0], 1, 40)) &&
             optStr(data, 'fitText', 160) &&
             isValidProductImg(data.img) &&
             optStr(data, 'spec', 1000) &&
             optStr(data, 'models', 500) &&
             optTimeOrNum(data, 'updatedAt');
    }

    // ===============================================================
    // Domain Validators — Sales / Checkout Orders
    // ===============================================================

    // Validate a single line item inside sales.items
    function isValidSaleItem(item) {
      return item is map &&
             item.keys().hasOnly(['id', 'sku', 'name', 'qty', 'price']) &&
             item.size() == 5 &&
             validStr(item.id, 1, 64) &&
             validStr(item.sku, 1, 40) &&
             validStr(item.name, 1, 160) &&
             item.qty is int && item.qty >= 1 && item.qty <= 100 &&
             item.price is number && item.price >= 0 && item.price <= 50000;
    }

    // O(1)-expression list validator (1..30 items; validates first and last item)
    function isValidSaleItemsList(items) {
      return items is list &&
             items.size() >= 1 &&
             items.size() <= 30 &&
             isValidSaleItem(items[0]) &&
             (items.size() == 1 || isValidSaleItem(items[items.size() - 1]));
    }

    // Validate allowed order status workflow transitions on Admin update
    function isValidSaleStatusTransition(prevStatus, nextStatus) {
      return prevStatus == nextStatus ||
             (prevStatus == 'Pendiente' && nextStatus in ['Pagado', 'Entregado', 'Cancelado']) ||
             (prevStatus == 'Pagado' && nextStatus in ['Entregado', 'Cancelado']) ||
             (prevStatus == 'Cancelado' && nextStatus == 'Pendiente');
    }

    // Full sale validator for checkout creation (O(1) expressions regardless of item count)
    function isValidSaleCreate(data) {
      return data.keys().hasOnly([
               'id', 'date', 'createdAt', 'client', 'phone', 'moto',
               'delivery', 'install', 'payMethod', 'status',
               'stockDeducted', 'total', 'items', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'id', 'date', 'createdAt', 'client', 'phone', 'moto',
               'delivery', 'install', 'payMethod', 'status',
               'stockDeducted', 'total', 'items'
             ]) &&
             validStr(data.id, 3, 24) &&
             validStr(data.date, 1, 60) &&
             (data.createdAt is timestamp ||
              (data.createdAt is number && data.createdAt > 0 && data.createdAt <= 9999999999999)) &&
             validStr(data.client, 1, 80) &&
             validStr(data.phone, 6, 15) &&
             data.phone.matches('^[0-9+ -]+$') &&
             validStr(data.moto, 1, 100) &&
             validStr(data.delivery, 1, 140) &&
             data.install is bool &&
             validStr(data.payMethod, 1, 80) &&
             data.status in ['Pendiente', 'Pagado', 'Entregado', 'Cancelado'] &&
             data.stockDeducted is bool &&
             data.total is number && data.total > 0 && data.total <= 50000 &&
             isValidSaleItemsList(data.items) &&
             optTimeOrNum(data, 'updatedAt');
    }

    // Lean validator for Admin status/stockDeducted updates (all other fields immutable)
    function isValidSaleStatusUpdate(prev, next) {
      return next.diff(prev).affectedKeys().hasOnly(['status', 'stockDeducted', 'updatedAt']) &&
             next.status in ['Pendiente', 'Pagado', 'Entregado', 'Cancelado'] &&
             next.stockDeducted is bool &&
             isValidSaleStatusTransition(prev.status, next.status) &&
             (!prev.stockDeducted ||
              next.stockDeducted == true ||
              next.status == 'Cancelado') &&
             optTimeOrNum(next, 'updatedAt');
    }

    // ===============================================================
    // Domain Validators — Order Status (Zero-PII Public Tracker)
    // ===============================================================

    // Validate verifiedAt as null, timestamp, or non-negative epoch millis
    function isValidVerifiedAt(val) {
      return val == null ||
             val is timestamp ||
             (val is number && val >= 0 && val <= 9999999999999);
    }

    // Full order_status document validator (enforced on both create and update)
    function isValidOrderStatusDoc(data) {
      return data.keys().hasOnly([
               'orderId', 'status', 'total', 'payMethod',
               'verifiedAt', 'receiptCode', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'orderId', 'status', 'total', 'payMethod',
               'verifiedAt', 'receiptCode'
             ]) &&
             validStr(data.orderId, 3, 24) &&
             data.status in ['Pendiente', 'Pagado', 'Entregado', 'Cancelado'] &&
             data.total is number && data.total > 0 && data.total <= 50000 &&
             validStr(data.payMethod, 1, 80) &&
             isValidVerifiedAt(data.verifiedAt) &&
             data.receiptCode is string && data.receiptCode.size() <= 40 &&
             optTimeOrNum(data, 'updatedAt');
    }

    // Enforce immutable order metadata on Admin updates
    function isOrderStatusImmutableUnchanged(prev, next) {
      return next.orderId == prev.orderId &&
             next.total == prev.total &&
             next.payMethod == prev.payMethod;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public product catalog (no PII). Admin-only mutations.
    match /inventory/{productId} {
      allow read: if true;
      allow create: if isAdmin() &&
                       isValidInventoryItem(request.resource.data);
      allow update: if isAdmin() && (
                       isValidInventoryQuickUpdate(resource.data, request.resource.data) ||
                       (isValidInventoryItem(request.resource.data) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']))
                     );
      allow delete: if isAdmin();
    }

    // Customer checkout orders (contains PII: phone, name, delivery address).
    // Storefront customers may create new 'Pendiente' orders without Firebase Auth,
    // but ONLY Admin can read, list, update (status/stockDeducted/updatedAt), or delete.
    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if isValidSaleCreate(request.resource.data) &&
                       (
                         (
                           !('updatedAt' in request.resource.data) &&
                           request.resource.data.status == 'Pendiente' &&
                           request.resource.data.stockDeducted == false &&
                           isReasonableCreatedAt(request.resource.data.createdAt)
                         ) ||
                         isAdmin()
                       );
      allow update: if isAdmin() &&
                       isValidSaleStatusUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // Zero-PII public order status tracker (matched by unguessable saleId).
    // Public single-document get allows live onSnapshot tracking without exposing PII
    // or allowing collection enumeration. Public create is locked to initial 'Pendiente' state.
    match /order_status/{saleId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidOrderStatusDoc(request.resource.data) &&
                       (
                         (
                           request.resource.data.status == 'Pendiente' &&
                           request.resource.data.verifiedAt == null &&
                           request.resource.data.receiptCode == ''
                         ) ||
                         isAdmin()
                       );
      allow update: if isAdmin() &&
                       isValidOrderStatusDoc(request.resource.data) &&
                       isOrderStatusImmutableUnchanged(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny — Block all unspecified collections & subcollections
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
